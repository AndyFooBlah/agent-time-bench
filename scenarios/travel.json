{
  "domain": "travel",
  "description": "Travel assistant over the user's flight bookings. Speciality: flight times are spoken in the airport's local zone, not the user's home zone and not UTC.",
  "tools": [
    {
      "name": "search_trips",
      "description": "Search the user's booked flight segments. Returns segments whose scheduled departure falls in [start_utc, end_utc). Both bounds are required and must be UTC ISO 8601 strings (e.g. 2026-08-01T04:00:00Z); start is inclusive, end is exclusive.",
      "params": [
        {
          "name": "query",
          "type": "string",
          "description": "Free-text airline/airport filter (optional; empty returns all segments in range)",
          "required": false
        },
        {
          "name": "start_utc",
          "type": "string",
          "description": "Range start, UTC ISO 8601, inclusive",
          "required": true
        },
        {
          "name": "end_utc",
          "type": "string",
          "description": "Range end, UTC ISO 8601, exclusive",
          "required": true
        }
      ],
      "mock": {
        "kind": "filter-rows",
        "rowsKey": "trips",
        "timestampField": "depart_utc",
        "startParam": "start_utc",
        "endParam": "end_utc"
      }
    },
    {
      "name": "get_flight_status",
      "description": "Look up a specific flight by flight number. Returns scheduled departure and arrival as UTC instants (depart_utc, arrive_utc) plus the departure/arrival airports and their IANA time zones (depart_tz, arrive_tz).",
      "params": [
        {
          "name": "flight",
          "type": "string",
          "description": "Flight number, e.g. DL423",
          "required": true
        }
      ],
      "mock": {
        "kind": "static"
      }
    },
    {
      "name": "get_next_trip",
      "description": "Return the user's next upcoming booked flight segment (soonest scheduled departure after now), with UTC departure/arrival instants, airports, and their IANA time zones.",
      "params": [],
      "mock": {
        "kind": "static"
      }
    }
  ],
  "scenarios": [
    {
      "id": "trv-01",
      "title": "thursday-departure-airport-clock",
      "context": {
        "now": "2026-07-28T09:10:00-04:00",
        "timeZone": "America/New_York",
        "locale": "en-US"
      },
      "user": "What time does my flight leave on Thursday?",
      "mocks": {
        "search_trips": {
          "rows": [
            {
              "name": "AA181 JFK-LAX",
              "flight": "AA181",
              "depart_airport": "JFK",
              "depart_tz": "America/New_York",
              "arrive_airport": "LAX",
              "arrive_tz": "America/Los_Angeles",
              "depart_utc": "2026-07-28T14:05:00Z",
              "arrive_utc": "2026-07-28T20:25:00Z"
            },
            {
              "name": "DL423 LAX-JFK",
              "flight": "DL423",
              "depart_airport": "LAX",
              "depart_tz": "America/Los_Angeles",
              "arrive_airport": "JFK",
              "arrive_tz": "America/New_York",
              "depart_utc": "2026-07-30T20:15:00Z",
              "arrive_utc": "2026-07-31T01:40:00Z"
            },
            {
              "name": "B6801 JFK-MIA",
              "flight": "B6801",
              "depart_airport": "JFK",
              "depart_tz": "America/New_York",
              "arrive_airport": "MIA",
              "arrive_tz": "America/New_York",
              "depart_utc": "2026-08-08T13:30:00Z",
              "arrive_utc": "2026-08-08T16:45:00Z"
            }
          ]
        },
        "get_flight_status": {
          "response": {
            "flight": "DL423",
            "status": "On time",
            "depart_utc": "2026-07-30T20:15:00Z",
            "depart_airport": "LAX",
            "depart_tz": "America/Los_Angeles",
            "arrive_utc": "2026-07-31T01:40:00Z",
            "arrive_airport": "JFK",
            "arrive_tz": "America/New_York"
          }
        },
        "get_next_trip": {
          "response": {
            "flight": "AA181",
            "depart_utc": "2026-07-28T14:05:00Z",
            "depart_airport": "JFK",
            "depart_tz": "America/New_York",
            "arrive_utc": "2026-07-28T20:25:00Z",
            "arrive_airport": "LAX",
            "arrive_tz": "America/Los_Angeles"
          }
        }
      },
      "expect": {
        "toolCalls": [
          {
            "tool": "search_trips",
            "graded": [
              "start_utc",
              "end_utc"
            ],
            "argKinds": {
              "start_utc": "instant-start",
              "end_utc": "instant-end"
            },
            "admissible": [
              {
                "start_utc": "2026-07-30T04:00:00Z",
                "end_utc": "2026-07-31T04:00:00Z"
              },
              {
                "start_utc": "2026-07-30T07:00:00Z",
                "end_utc": "2026-07-31T07:00:00Z"
              }
            ],
            "verifyPhrase": {
              "phrase": "on Thursday",
              "disagreementNote": "nl2time's primary resolution is the most recent PAST Thursday (Jul 23); the upcoming Thursday (Jul 30) that this future-looking flight question requires appears only in its alternatives list"
            }
          }
        ],
        "response": {
          "checks": [
            {
              "kind": "clockTime",
              "instant": "2026-07-30T20:15:00Z",
              "tz": "America/Los_Angeles",
              "rejectUtcClock": true,
              "note": "Departure is from LAX: 1:15pm PDT. 8:15pm/20:15 is the UTC rendering"
            },
            {
              "kind": "regex",
              "reject": "\\b4:15\\b",
              "note": "4:15pm is the user's home-zone (ET) rendering of the LAX departure — also wrong; the answer must be in the departure airport's zone"
            }
          ]
        }
      },
      "directions": [
        "nl2time",
        "time2nl"
      ],
      "rationale": "Now = TUESDAY Jul 28 2026, 9:10am EDT (UTC-4). 'Thursday' = upcoming Thu Jul 30. The user sits in New York but the Thursday flight departs LAX, so both day readings are admitted: NY civil Thursday [Jul 30 00:00 ET, Jul 31 00:00 ET) = [2026-07-30T04:00Z, 2026-07-31T04:00Z) and LAX civil Thursday [Jul 30 00:00 PT, Jul 31 00:00 PT) = [2026-07-30T07:00Z, 2026-07-31T07:00Z). DL423 departs 2026-07-30T20:15Z = Thu 1:15pm PDT = Thu 4:15pm EDT — inside both windows (count 1 under each); AA181 (Tue Jul 28 14:05Z) and B6801 (Sat Aug 8 13:30Z) are outside both. The answer clock must be airport-local: 1:15pm PDT; 4:15pm (ET) and 8:15pm/20:15 (UTC) are the traps. get_next_trip is consistently the Tue Jul 28 flight (14:05Z > now 13:10Z), so it cannot short-circuit the Thursday search."
    },
